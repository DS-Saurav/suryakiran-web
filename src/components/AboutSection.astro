---
const { lang = "ne" } = Astro.props;
const isNe = lang === "ne";

// ── Section: Firm Heritage ──
const heritage = {
  tag: isNe ? "हाम्रो बारे" : "About Us",
  heading: isNe ? "पूर्वाधारको वास्तुकार" : "Architects of Infrastructure",
  body: isNe
    ? "सूर्य किरण रिन्युएबल एनर्जी प्रा.लि. नेपालको पूर्वाधार र ऊर्जा प्रणालीहरूको योजना, डिजाइन, निर्माण र मर्मत सम्भारको लागि एक विश्वसनीय, घरेलु साझेदारको रूपमा खडा छ। कर्णाली प्रदेश, सुर्खेतको वीरेन्द्रनगरमा रहेको, हामी सिभिल इन्जिनियरिङ, नवीकरणीय ऊर्जा, रणनीतिक परामर्श, र निर्माण पर्यवेक्षण — सबै एकीकृत, सबै उत्तरदायी प्रदान गर्छौं।"
    : "Surya Kiran Renewable Energy Pvt. Ltd. stands as a trusted, domestic partner for planning, designing, building, and maintaining the infrastructure and energy systems that underpin Nepal's growth. Based in Birendranagar, Surkhet, in Karnali Province, we deliver civil engineering, renewable energy, strategic consultancy, and construction supervision — all integrated, all accountable.",
};

// ── Section: Mission, Vision, Values ──
const mvv = [
  {
    title: isNe ? "हाम्रो मिशन" : "Our Mission",
    desc: isNe
      ? "नेपालको वृद्धिलाई आधार बनाउने पूर्वाधार र ऊर्जा प्रणालीहरू — सुरुको सर्वेक्षणदेखि अन्तिम कमिसनिङ र त्यसपछिको मर्मतसमेत — योजना, डिजाइन, निर्माण र मर्मत गर्न।"
      : "To plan, design, build, and maintain the infrastructure and energy systems that underpin Nepal's growth — from first survey to final commissioning and beyond.",
  },
  {
    title: isNe ? "हाम्रो दृष्टि" : "Our Vision",
    desc: isNe
      ? "पूर्वाधार विकासमा नेपालको सबैभन्दा भरपर्दो नाम बन्ने — जहाँ गुणस्तर, पारदर्शिता र स्थानीय विशेषज्ञता हरेक परियोजनाको आधार हुन्।"
      : "To become Nepal's most trusted name in infrastructure development — where quality, transparency, and local expertise are the foundation of every project.",
  },
  {
    title: isNe ? "हाम्रो मूल्य" : "Our Values",
    desc: isNe
      ? "जवाफदेहिता: हामी हरेक डेलिभर गरेको कामको पछाडि उभिन्छौं। अखण्डता: सरकारी मापदण्ड र वातावरणीय प्रतिबद्धताको पालना हाम्रो आधार रेखा हो। स्थानीय: नेपाली-निर्मित, नेपाली-सञ्चालित, नेपाली अवस्थाको लागि ईन्जिनियर गरिएको।"
      : "Accountability: We stand behind every deliverable. Integrity: Compliance with government standards and environmental commitments is our baseline. Local: Nepali-built, Nepali-operated, engineered for Nepali conditions.",
  },
];

// ── Section: Leadership ──
const leaders = isNe
  ? [
    { name: "मोहन के.सी.", role: "कार्यकारी निर्देशक / परियोजना नेता", bio: "सिभिल इन्जिनियरिङ र नवीकरणीय ऊर्जामा ३० वर्षभन्दा बढीको अनुभव। कर्णाली प्रदेशभर ठूला पूर्वाधार र ऊर्जा परियोजनाहरूको डेलिभरीको नेतृत्व गरेका।", image: "/images/mohan_kc.png" },
    { name: "सन्देश के.सी.", role: "प्रशासन प्रमुख", bio: "सार्वजनिक खरिद, अनुपालन, र सरकारी सम्बन्धमा विशेषज्ञता। सबै परियोजनाको दस्तावेजीकरण राष्ट्रिय मापदण्ड अनुसार सुनिश्चित गर्ने।", image: "/images/sandesh_kc.png" },
  ]
  : [
    { name: "Mohan K.C.", role: "Managing Director / Project Lead", bio: "Over 30 years of experience in civil engineering and renewable energy. Has led delivery of major infrastructure and energy projects across Karnali Province.", image: "/images/mohan_kc.png" },
    { name: "Sandesh K.C.", role: "Head of Administration", bio: "Expertise in public procurement, compliance, and government liaison. Ensures all project documentation meets national standards.", image: "/images/sandesh_kc.png" },
  ];

// ── Section: Timeline ──
const timeline = isNe
  ? [
    { year: "२००८", desc: "सूर्य किरणको स्थापना, कर्णाली प्रदेशमा सिभिल इन्जिनियरिङ परामर्शमा केन्द्रित।" },
    { year: "२०१२", desc: "पहिलो ठूलो सरकारी पूर्वाधार परियोजना डेलिभर — वीरेन्द्रनगरमा सडक र जल निकासी।" },
    { year: "२०१६", desc: "नवीकरणीय ऊर्जा विभाग विस्तार: सौर्य छत, पानी पम्पिङ, र प्रणाली निर्माण।" },
    { year: "२०२०", desc: "सातै प्रदेशमा सेवा विस्तार; २०० भन्दा बढी परियोजनाहरू डेलिभर।" },
    { year: "२०२४", desc: "कर्णाली प्रदेशमा पूर्ण-सेवा पूर्वाधार र ऊर्जा फर्मको रूपमा स्थापित।" },
  ]
  : [
    { year: "2008", desc: "Surya Kiran founded, focusing on civil engineering consultancy in Karnali Province." },
    { year: "2012", desc: "First major government infrastructure project delivered — roads and drainage in Birendranagar." },
    { year: "2016", desc: "Renewable energy division expanded: solar rooftop, water pumping, and system fabrication." },
    { year: "2020", desc: "Expanded services to all seven provinces; over 200 projects delivered." },
    { year: "2024", desc: "Established as a full-service infrastructure and energy firm in Karnali Province." },
  ];

// ── Section: Certifications ──
const certs = isNe
  ? [
    "नेपाल सरकार, सार्वजनिक खरिद अनुगमन कार्यालयमा दर्ता",
    "कर्णाली प्रदेश सरकार, योजना आयोग — स्वीकृत आपूर्तिकर्ता",
    "नेपाल ऊर्जा प्राधिकरण — नवीकरणीय ऊर्जा आयोजनाको लागि दर्ता",
    "नेपाल इन्जिनियर्स एसोसिएसन — व्यावसायिक सहयोगी",
  ]
  : [
    "Registered with Government of Nepal, Public Procurement Monitoring Office",
    "Karnali Provincial Government, Planning Commission — Approved Supplier",
    "Nepal Electricity Authority — Registered for Renewable Energy Projects",
    "Nepal Engineers' Association — Professional Affiliate",
  ];
---

<section class="section about-section animate-section" id="about">
  <div class="container">
    <div class="about-header">
      <span class="section-tag">{heritage.tag}</span>
      <h2 class="section-heading">{heritage.heading}</h2>
      <hr class="section-rule" />
      <p class="section-subheading">{heritage.body}</p>
    </div>
  </div>

  <!-- Mission, Vision, Values -->
  <div class="mvv-strip">
    <div class="container">
      <div class="mvv-grid">
        {mvv.map((item) => (
          <div class="mvv-card">
            <div class="mvv-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C5A55A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              </svg>
            </div>
            <h3 class="mvv-title">{item.title}</h3>
            <p class="mvv-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Timeline -->
  <div class="container">
    <div class="timeline-section">
      <div class="section-header timeline-header">
        <span class="section-tag">{isNe ? "हाम्रो यात्रा" : "Our Journey"}</span>
        <h2 class="section-heading">{isNe ? "माइलस्टोनहरू" : "Milestones"}</h2>
        <hr class="section-rule" />
      </div>
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item">
            <div class="timeline-marker">
              <span class="timeline-dot"></span>
              <span class="timeline-year">{item.year}</span>
            </div>
            <div class="timeline-content">
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Leadership -->
  <div class="leadership-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">{isNe ? "नेतृत्व" : "Leadership"}</span>
        <h2 class="section-heading">{isNe ? "हाम्रो टोली" : "Our Team"}</h2>
        <hr class="section-rule" />
        <p class="section-subheading">
          {isNe
            ? "हाम्रो टोली नेपाली ईन्जिनियर, प्राविधिक र प्रशासकहरू मिलेर बनेको छ जो कर्णालीको भूगोल, नियमन र समुदायहरू बुझ्छन्।"
            : "Our team is composed of Nepali engineers, technicians, and administrators who understand the geography, regulation, and communities of the region."}
        </p>
      </div>
      <div class="leaders-grid">
        {leaders.map((leader) => (
          <div class="leader-card card">
            <div class="leader-avatar">
              {leader.image ? (
                <img src={leader.image} alt={leader.name} class="leader-img" />
              ) : (
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="16" r="8" fill="#DFE6E9"/>
                  <ellipse cx="24" cy="38" rx="16" ry="10" fill="#DFE6E9"/>
                  <path d="M24 10C21.5 10 20 12 20 14.5C20 17 22 18 24 18C26 18 28 17 28 14.5C28 12 26.5 10 24 10Z" fill="#B2BEC3"/>
                  <ellipse cx="24" cy="35" rx="12" ry="7" fill="#B2BEC3"/>
                </svg>
              )}
            </div>
            <div class="leader-info">
              <strong class="leader-name">{leader.name}</strong>
              <span class="leader-role">{leader.role}</span>
              <p class="leader-bio">{leader.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Certifications -->
  <div class="container">
    <div class="certs-section">
      <div class="section-header">
        <span class="section-tag">{isNe ? "प्रमाणपत्र" : "Certifications"}</span>
        <h2 class="section-heading">{isNe ? "मान्यता र अनुपालन" : "Accreditations & Compliance"}</h2>
        <hr class="section-rule" />
      </div>
      <div class="certs-grid">
        {certs.map((cert) => (
          <div class="cert-item">
            <span class="cert-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <rect x="1" y="1" width="16" height="16" rx="3" stroke="#C5A55A" stroke-width="1.5"/>
                <path d="M5 9.5L7.5 12L13 6.5" stroke="#C5A55A" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <span>{cert}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    scroll-margin-top: 5rem;
  }

  .about-header {
    margin-bottom: 1rem;
  }

  /* ── MVV Strip ── */
  .mvv-strip {
    background-color: var(--color-white);
    padding: 4rem 0;
    margin-bottom: 3rem;
  }
  .mvv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-gutter);
  }
  .mvv-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mvv-icon {
    margin-bottom: 0.5rem;
  }
  .mvv-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-forest-deep);
  }
  .mvv-desc {
    font-size: 0.9375rem;
    color: var(--color-slate-mid);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .mvv-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Timeline ── */
  .timeline-section {
    margin-bottom: 3rem;
  }
  .timeline-header {
    margin-bottom: 1rem;
  }
  .timeline {
    position: relative;
    padding-left: 3rem;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-slate-light);
  }
  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-marker {
    position: absolute;
    left: -3rem;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--color-forest-deep);
    border: 3px solid var(--color-ivory);
    box-shadow: 0 0 0 2px var(--color-forest-deep);
  }
  .timeline-year {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-gold);
    white-space: nowrap;
  }
  .lang-ne .timeline-year {
    font-family: var(--font-deva-heading);
  }
  .timeline-content {
    padding-top: 0.125rem;
  }
  .timeline-content p {
    font-size: 0.9375rem;
    color: var(--color-slate-mid);
    line-height: 1.6;
    max-width: 600px;
  }

  /* ── Leadership ── */
  .leadership-section {
    background-color: var(--color-ivory);
    padding: 4rem 0;
    margin-bottom: 3rem;
  }
  .leaders-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-gutter);
  }
  .leader-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .leader-avatar {
    flex-shrink: 0;
  }
  .leader-img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-gold);
    display: block;
  }
  .leader-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .leader-name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-forest-deep);
  }
  .leader-role {
    font-size: 0.8125rem;
    color: var(--color-gold);
    font-weight: 500;
  }
  .leader-bio {
    font-size: 0.875rem;
    color: var(--color-slate-mid);
    line-height: 1.6;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .leaders-grid {
      grid-template-columns: 1fr;
    }
    .leader-card {
      flex-direction: column;
    }
  }

  /* ── Certifications ── */
  .certs-section {
    margin-bottom: 2rem;
  }
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .cert-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: var(--color-white);
    box-shadow: var(--shadow-card);
    font-size: 0.9375rem;
    color: var(--color-slate-dark);
    line-height: 1.4;
  }
  .cert-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  @media (max-width: 768px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
